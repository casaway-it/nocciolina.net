---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../Nav.astro";
import GalleryImage from "../GalleryImage.astro";
import GoogleMap from "../GoogleMap.astro";
import BookingWidget from "../BookingWidget.astro";
import { getContent } from "../../i18n/content";
import type { Locale } from "../../i18n/locales";
import { siteConfig } from "../../config/site";

import mailbox from "../../assets/mailbox.jpg";

type Props = { lang: Locale };
const { lang } = Astro.props;
const t = getContent(lang);
const c = t.contact;

const mapQuery = `${siteConfig.geo.lat},${siteConfig.geo.lng}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}`;
---

<BaseLayout lang={lang} pageKey="contact" title={c.title} description={c.description}>
  <Nav lang={lang} pageKey="contact" />

  <main id="main">
    <header class="page-head">
      <p class="label-eyebrow">{c.pageHead.eyebrow}</p>
      <h1>{c.pageHead.title}</h1>
      <p class="lead">{c.pageHead.lead}</p>
    </header>

    <section class="container section" style="padding-block-start: 0;">
      <div class="section-grid">
        <aside class="menu-aside">
          <GalleryImage src={mailbox} alt={c.mailboxAlt} gallery="contact" loading="eager" />

          <div class="reservation-facts" style="margin-top: 2rem;">
            <div>
              <p class="label-eyebrow">{c.labels.whatsapp}</p>
              <p>
                <a href={siteConfig.whatsapp.href} rel="noreferrer">{siteConfig.whatsapp.display}</a>
                <br />
                <span style="color: var(--muted-foreground); font-size: 0.85rem;">{c.labels.whatsappNote}</span>
              </p>
            </div>
            <div>
              <p class="label-eyebrow">{c.labels.email}</p>
              <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
            </div>
            <div style="grid-column: 1 / -1;">
              <p class="label-eyebrow">{c.labels.address}</p>
              <p>
                {siteConfig.address.street}<br />
                {siteConfig.address.postalCode} {siteConfig.address.locality}<br />
                {siteConfig.address.region} - {siteConfig.address.country}
              </p>
              <p style="margin-top: 0.5rem;"><a href={directionsHref} rel="noreferrer" target="_blank">{t.footer.openInMaps} <span aria-hidden="true">↗</span></a></p>
            </div>
          </div>
        </aside>

        <BookingWidget lang={lang} />
      </div>
    </section>
  </main>

  <GoogleMap title={c.mapTitle} eyebrow={c.mapTitle} />
</BaseLayout>
