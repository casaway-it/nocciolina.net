---
import { locales, localeMeta, localePath, type Locale } from "../i18n/locales";
import { getContent } from "../i18n/content";

type Props = {
  lang: Locale;
  pageKey: string;
};

const { lang, pageKey } = Astro.props;
const t = getContent(lang);
---

<details class="locale-switcher">
  <summary aria-label={t.nav.languageLabel}>
    <span class="locale-switcher__code">{lang.toUpperCase()}</span>
    <span aria-hidden="true" class="locale-switcher__caret">▾</span>
  </summary>
  <ul class="locale-switcher__menu" role="list">
    {locales.map((l) => (
      <li>
        <a
          href={localePath(l, pageKey)}
          hreflang={localeMeta[l].htmlLang}
          aria-current={l === lang ? "true" : undefined}
          data-locale={l}
        >
          {localeMeta[l].label}
          <span class="locale-switcher__sub">{l.toUpperCase()}</span>
        </a>
      </li>
    ))}
  </ul>
</details>
