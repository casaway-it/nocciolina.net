---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  gallery: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  square?: boolean;
  class?: string;
}

const {
  src,
  alt,
  gallery,
  width,
  height,
  loading = "lazy",
  square = false,
  class: className,
} = Astro.props;

const w = width ?? src.width;
const h = height ?? src.height;

// Full-size, natural-aspect image for the lightbox
const full = await getImage({
  src,
  format: "webp",
  quality: 88,
  width: Math.min(src.width, 2200),
});
---

<button
  type="button"
  class:list={["gallery-trigger", square && "gallery-trigger--square", className]}
  data-gallery={gallery}
  data-src={full.src}
  data-alt={alt}
  aria-label={`Open image: ${alt}`}
>
  <Image
    src={src}
    alt={alt}
    width={w}
    height={h}
    loading={loading}
    widths={square ? [320, 600, 900] : [600, 1200, 1800]}
    sizes={square ? "(max-width: 540px) 50vw, (max-width: 900px) 33vw, 20vw" : "(max-width: 900px) 100vw, 50vw"}
  />
</button>
