---
// Shared lightbox dialog. One instance per page, driven by any
// <button data-gallery="GROUP" data-src="..." data-alt="..."> in the page.
---

<dialog id="lightbox" class="lightbox" aria-label="Image viewer">
  <div class="lightbox-stage">
    <button type="button" class="lightbox-close" aria-label="Close">×</button>
    <button type="button" class="lightbox-prev" aria-label="Previous image">‹</button>
    <button type="button" class="lightbox-next" aria-label="Next image">›</button>
    <img alt="" />
  </div>
  <p class="lightbox-caption"></p>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.getElementById("lightbox");
    if (!dialog) return;
    const img = dialog.querySelector("img");
    const caption = dialog.querySelector(".lightbox-caption");
    const prevBtn = dialog.querySelector(".lightbox-prev");
    const nextBtn = dialog.querySelector(".lightbox-next");
    const closeBtn = dialog.querySelector(".lightbox-close");

    let items = [];
    let index = 0;

    function render() {
      const item = items[index];
      if (!item) return;
      img.src = item.src;
      img.alt = item.alt;
      const counter = items.length > 1 ? ` — ${index + 1} / ${items.length}` : "";
      caption.textContent = (item.alt || "") + counter;
      const hasMany = items.length > 1;
      prevBtn.hidden = !hasMany;
      nextBtn.hidden = !hasMany;
    }

    function openFrom(trigger) {
      const group = trigger.dataset.gallery;
      const triggers = Array.from(document.querySelectorAll(`[data-gallery="${group}"]`));
      items = triggers.map((t) => ({ src: t.dataset.src, alt: t.dataset.alt || "" }));
      index = Math.max(0, triggers.indexOf(trigger));
      render();
      if (typeof dialog.showModal === "function") dialog.showModal();
      else dialog.setAttribute("open", "");
    }

    function next() { index = (index + 1) % items.length; render(); }
    function prev() { index = (index - 1 + items.length) % items.length; render(); }

    nextBtn.addEventListener("click", (e) => { e.stopPropagation(); next(); });
    prevBtn.addEventListener("click", (e) => { e.stopPropagation(); prev(); });
    closeBtn.addEventListener("click", (e) => { e.stopPropagation(); dialog.close(); });

    // Click outside the image closes
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog || e.target.classList.contains("lightbox-stage")) {
        dialog.close();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (!dialog.open) return;
      if (e.key === "ArrowRight") { e.preventDefault(); next(); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); prev(); }
    });

    document.addEventListener("click", (e) => {
      const trigger = e.target.closest("[data-gallery]");
      if (!trigger) return;
      e.preventDefault();
      openFrom(trigger);
    });
  })();
</script>
